# Timer for dg-replication-sync.service: re-render /etc/replication.yml
# from the live database list every five minutes.
#
# Copy to /etc/systemd/system/dg-replication-sync.timer on the target host
# alongside dg-replication-sync.service, then
#   systemctl daemon-reload && systemctl enable --now dg-replication-sync.timer
#
# The five-minute interval bounds the replication-coverage window for a
# newly created database (the hourly snapshot covers the interim). The
# sync is a no-op unless the rendered config changed, so the steady-state
# cost of this cadence is one loopback `dg list` per interval.

[Unit]
Description=Periodic db-gateway replication config sync

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
