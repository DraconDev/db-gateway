# Steady check heartbeat template (non-installing, operator machine).
#
# Copy to ~/.config/systemd/user/steady-heartbeat.service on the operator
# machine, replace every braced placeholder, then
#   systemctl --user daemon-reload
# Nothing in this repository installs, enables, or starts this unit.
#
# Runs scripts/steady-heartbeat.sh once per steady-heartbeat.timer fire:
# one write plus read-back through the demo's scoped key, proving
# the write path, the read path, and replication liveness every hour.
# Uses the scoped demo key only; the owner key never appears here.

[Unit]
Description=Steady check heartbeat

[Service]
Type=oneshot
Environment=DG_BIN={{DG_BINARY}}
ExecStart={{DG_HEARTBEAT_SCRIPT}} --server {{DG_SERVER}} --key-file {{DG_DEMO_KEY_FILE}} --database {{DG_DEMO_DATABASE}}
