# Keep /etc/replication.yml in step with the gateway's live databases.
#
# Copy to /etc/systemd/system/dg-replication-sync.service on the target
# host alongside dg-replication-sync.timer, then
#   systemctl daemon-reload && systemctl enable --now dg-replication-sync.timer
# scripts/install-replication.sh installs both units and the script.
#
# Why (docs/audit-2026-10-19.md A2): replication reads its config once at
# startup, so a database created after install was never replicated until
# someone re-rendered the config by hand. This oneshot re-renders from
# `dg list` and restarts dg-replication only when the rendered config
# actually changed, so a create/delete is picked up within one timer
# interval and steady state costs one no-op `dg list` per interval.
#
# Runs as root: it must replace a file in /etc and restart the sidecar.
# The `dg list` call itself is dropped to the dg user inside the script
# (the owner key is 0600 dg:dg). No secret is read into this unit: the
# script substitutes only bucket/endpoint/region and leaves the
# credential keys as ${LITESTREAM_S3_*} references for the sidecar's own
# EnvironmentFile.

[Unit]
Description=db-gateway replication config sync (re-render from live databases)
After=network.target dg.service dg-replication.service
Wants=dg.service

[Service]
Type=oneshot
# Pin the dg path: the script runs `dg list` as the dg user via sudo,
# and sudo's secure_path is not something to depend on for /usr/local/bin.
Environment=DG_BIN=/usr/local/bin/dg
ExecStart=/usr/local/bin/replication-sync.sh
# Transient oneshot (bash + python3 + one loopback dg CLI call); capped
# well above its working set so a pathological run cannot pressure the
# 1 GiB host budget shared with dg.service and dg-replication.service.
MemoryMax=64M
