# Off-host replication sidecar for dg.
#
# Copy to /etc/systemd/system/dg-replication.service on the target host, then
#   systemctl daemon-reload
# Nothing in this repository installs, enables, or starts this unit.
#
# The credentials never appear here. /etc/dg/replication.env is the only copy
# of the secret on the host (mode 0600, owner dg:dg) and is loaded by
# systemd at ExecStart time via EnvironmentFile=; nothing else on the host
# is permitted to read it.

[Unit]
Description=db-gateway off-host replication sidecar (replication)
After=network.target
Wants=dg.service
After=dg.service

[Service]
Type=simple
User=dg
Group=dg
ExecStart=/usr/local/bin/replication replicate -config /etc/replication.yml
EnvironmentFile=/etc/dg/replication.env
Restart=on-failure
RestartSec=5s
# MemoryMax: the supervised sidecar cap. The measured figure is the
# dg-sandbox packet's gate-9 run: 45,632 KiB replication peak (34,576 KiB
# restore) under a kernel-enforced 1 GiB scope. This cap is set at 96 MiB,
# giving >2x headroom over the measured replication peak, so a larger
# workload peak degrades gracefully instead of being OOM-killed. The
# sidecar's budget is its own: the gateway unit carries its own cap
# (64 MiB, matching the host's enforcement), and the two units do not
# have to agree. An early revision of this unit
# carried 8 MiB, derived by analogy from the gateway's SQLite cache
# ceiling -- the wrong model for replication, whose memory is the S3
# transfer and compaction working set rather than a page cache -- and the
# sidecar was OOM-killed on its first start. The 1 GiB host budget is
# dg.service (64 MiB) + this (96 MiB) + OS, which fits with room.
# Evidence: docs/evidence/sandbox-packet-2026-09-29-rehearsal.log gate 9, and the
# dg-replication journal's oom-kill + restart counter from the 8 MiB cap.
MemoryMax=96M

[Install]
WantedBy=multi-user.target
