# App-host loopback socket for the mesh edge (non-installing
# template; audit A9). Install on each APPLICATION host, not on the
# gateway host.
#
# Copy to /etc/systemd/system/dg-app-proxy.socket on the app host,
# then
#   systemctl daemon-reload && systemctl enable --now dg-app-proxy.socket
# Nothing in this repository installs, enables, or starts this unit.
#
# Binds the app host's own local-only, so applications keep using
# http://127.0.0.1:7432 origins (the client origin rule is unchanged
# by the mesh edge — docs/access-edge.md). The port matches the
# gateway's loopback default; if the app also runs something on
# 7432 locally, pick another loopback port here and point the app at
# it — the far end is unaffected.

[Unit]
Description=DB Gateway app-side loopback listen socket

[Socket]
ListenStream=127.0.0.1:7432
Accept=no

[Install]
WantedBy=sockets.target
