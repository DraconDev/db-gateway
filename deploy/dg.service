# DB Gateway service template (non-installing).
#
# Copy to /etc/systemd/system/dg.service on the target host, replace every
# braced placeholder (see docs/deployment.md for the value table), then
#   systemctl daemon-reload
# Nothing in this repository installs, enables, or starts this unit.

[Unit]
Description=DB Gateway — personal SQLite service
After=network.target

[Service]
Type=simple
User={{DG_USER}}
Group={{DG_USER}}
ExecStart={{DG_BINARY}} serve --listen {{DG_LISTEN}} --data-dir {{DG_DATA_DIR}}
WorkingDirectory={{DG_DATA_DIR}}
Restart=on-failure
RestartSec=5s

# Data directory stays writable and owned by the service user; everything
# else is read-only to the process.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths={{DG_DATA_DIR}}

# Credentials never appear here: the owner credential is created once with
# `dg init` (output redirected to a 0600 file), and client keys travel in
# 0600 --key-file files owned by {{DG_USER}}. No Environment= secrets.

# MemoryMax remains unset until the release-blocking measurements in
# docs/resource-budget.md are accepted. The local micro2 sample is not a
# deployment-wide cap; do not turn it into a hard limit from memory.
#
# Owner decision 2026-09-27: KEEP UNSET. A value chosen without a measurement
# is a guess, and a wrong hard cap does not degrade the service gracefully --
# it gets the gateway OOM-killed under exactly the burst the budget is meant to
# absorb. What would justify setting it: item 1 below (release-profile RSS
# under a realistic workload) plus item 3 (target OS baseline with the data
# dir hot) measured on the target host shape, with headroom for the Litestream
# sidecar from item 2. Note the page-cache component of that budget is ~24 MiB,
# not ~10 MiB: the gateway runs two independent admission lanes, 8 readers and
# 4 writers, each connection carrying a ~2 MiB cache.
# MemoryMax=64M

[Install]
WantedBy=multi-user.target
