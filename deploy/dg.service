# DB Gateway service template (non-installing).
#
# Copy to /etc/systemd/system/dg.service on the target host, replace every
# braced placeholder (see docs/deployment.md for the value table), then
#   systemctl daemon-reload
# Nothing in this repository installs, enables, or starts this unit.

[Unit]
Description=DB Gateway — personal SQLite service
After=network.target

[Service]
Type=simple
User={{DG_USER}}
Group={{DG_USER}}
ExecStart={{DG_BINARY}} serve --listen {{DG_LISTEN}} --data-dir {{DG_DATA_DIR}} --backup-root {{DG_BACKUP_ROOT}} --backup-cadence-secs 3600
WorkingDirectory={{DG_DATA_DIR}}
Restart=on-failure
RestartSec=5s

# Data directory and backup root stay writable and owned by the service
# user; everything else is read-only to the process.
#
# The backup root is writable because `dg backup run` publishes a set
# there on demand: it stages the set, validates every file, and renames
# it into place. Without the path here, ProtectSystem=strict makes the
# whole backup root read-only to the gateway and the run fails with an
# internal error — which is a confusing way to learn that the unit, not
# the command, was the problem.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths={{DG_DATA_DIR}} {{DG_BACKUP_ROOT}}

# Credentials never appear here: the owner credential is created once with
# `dg init` (output redirected to a 0600 file), and client keys travel in
# 0600 --key-file files owned by {{DG_USER}}. No Environment= secrets.

# MemoryMax: release-profile ceiling, re-measured on-target 2026-10-16.
# The binding term for the gateway process is the SQLite per-connection
# cache ceiling (READ_PERMITS=8 + WRITE_PERMITS=4 query connections, each
# pinned to PRAGMA cache_size=-2048 = 2 MiB, ceiling 12 * 2 MiB = 24 MiB)
# plus the three metadata connections (cache_size=-1024 = 1 MiB each,
# ceiling 3 MiB, not on the request hot path), not the process base RSS
# (deployment-host steady 6696 KiB across repeated samples; release burst peak
# 11192 KiB under a 1 GiB-enforced 50-way concurrent INSERT harness).
# MemoryMax is set ~2.7x above the query-connection ceiling and ~6x above
# the measured burst peak, so the burst the budget exists to absorb does
# not become an OOM kill. This value matches what the deployment-host host already
# enforces (MemoryMax=67108864, recorded in the deployment-host sampling
# record); an earlier revision shipped
# 96M in this template while the host ran 64M, and this edit resolves that
# drift toward the host fact. The sidecar (replication) runs in its own
# unit with its own MemoryMax (96M on-host); the 1 GiB host budget is the
# sum of this cap (64 MiB) plus the sidecar cap plus the OS, all of which
# fits. See the deployment-host measurement record and
# `src/store/admission.rs:12-14` / `src/execution.rs:39-50` for the
# cache ceiling itself.
MemoryMax=64M

[Install]
WantedBy=multi-user.target
